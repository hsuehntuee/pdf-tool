# Copy to .env (the app creates one automatically on first run).
PDFTOOL_USER=admin
# Either a plain password (hashed at startup) ...
# PDFTOOL_PASSWORD=change-me
# ... or a PBKDF2 hash written by `python -m app passwd`
# PDFTOOL_PASSWORD_HASH=pbkdf2$310000$...
PDFTOOL_SECRET=replace-with-a-long-random-string
# PDFTOOL_AUTH=off            # disable login (only for 127.0.0.1 use)
# PDFTOOL_HTTPS=on            # set when served behind HTTPS so the cookie is Secure
# PDFTOOL_SESSION_DAYS=30
# PDFTOOL_MAX_UPLOAD_MB=512
